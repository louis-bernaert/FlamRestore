generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  snapId    String
  phone     String
  createdAt DateTime @default(now())
  friends   Friend[]
}

model Friend {
  id        String   @id @default(cuid())
  name      String
  snapId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}
